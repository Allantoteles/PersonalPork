generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  createdAt   DateTime @default(now())
  usuarios    Usuario[]
}

model Usuario {
  id           String   @id @default(uuid())
  email        String   @unique
  nombre       String
  rolId        String?
  rol          Role?    @relation(fields: [rolId], references: [id])
  entrenadorId String?
  entrenador   Usuario? @relation("EntrenadorAtleta", fields: [entrenadorId], references: [id])
  atletas      Usuario[] @relation("EntrenadorAtleta")
  createdAt    DateTime @default(now())
}

model Ejercicio {
  id               String   @id @default(uuid())
  nombre           String
  nombreOriginal   String?
  grupoMuscular    String
  gruposMusculares String
  equipo           String?
  nivel            String   @default("intermediate")
  instrucciones    String
  categoria       String?
  creadoPor        String?
  createdAt        DateTime @default(now())
}

model Rutina {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  alumnoId  String
  entrenadorId String
  versiones RutinaVersion[]
}

model RutinaVersion {
  id              String   @id @default(uuid())
  rutinaOriginalId String?
  rutinaOriginal  Rutina?  @relation(fields: [rutinaOriginalId], references: [id])
  nombre          String
  descripcion     String?
  diaSemana       String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  ejercicios      RutinaEjercicioVersion[]
}

model RutinaEjercicioVersion {
  id              String   @id @default(uuid())
  rutinaVersionId String
  rutinaVersion   RutinaVersion @relation(fields: [rutinaVersionId], references: [id], onDelete: Cascade)
  ejercicioId     String
  series          Int      @default(3)
  repeticiones    Int      @default(10)
  peso            Float    @default(0)
  orden           Int      @default(0)
}

model RegistroEntrenamiento {
  id              String   @id @default(uuid())
  rutinaVersionId String?
  alumnoId        String
  fecha           DateTime @default(now())
  estado          String   @default("completado")
  horaInicio      String?
  horaFin         String?
  duracionMinutos Int?
  observaciones   String?
  createdAt       DateTime @default(now())
  detalles        DetalleEntrenamiento[]
}

model DetalleEntrenamiento {
  id                       String   @id @default(uuid())
  registroEntrenamientoId  String
  registro                 RegistroEntrenamiento @relation(fields: [registroEntrenamientoId], references: [id], onDelete: Cascade)
  rutinaEjercicioVersionId String
  numeroSerie              Int
  repeticiones             Int
  peso                     Float   @default(0)
  completado              Boolean @default(false)
}